{
  "name": "@baldin/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Document database engine, resource model, extension contracts, and multidatabase manager for Baldin.",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldin.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js"
    },
    "./encoding": {
      "types": "./dist/concerns/base62.d.ts",
      "import": "./dist/concerns/base62.js"
    },
    "./package.json": "./package.json",
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "UNLICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "fastest-validator": "^1.19.1",
    "json-stable-stringify": "^1.3.0",
    "lodash-es": "^4.18.1",
    "pino": "^10.3.1",
    "raffel": "1.0.26",
    "recker": "1.0.103",
    "tuiuiu.js": "1.0.63"
  },
  "optionalDependencies": {
    "@libsql/client": "^0.14.0",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "node-cron": "^4.0.0",
    "sqlite-vec": "^0.1.0"
  },
  "devDependencies": {
    "@types/argon2": "^0.15.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "25.5.2",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  }
}
