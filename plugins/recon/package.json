{
  "name": "@baldin/plugin-recon",
  "version": "0.1.0",
  "type": "module",
  "description": "Modular reconnaissance, security analysis, reporting, and uptime monitoring for Baldin.",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldin.git",
    "directory": "plugins/recon"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stages": {
      "types": "./dist/recon/stages/index.d.ts",
      "import": "./dist/recon/stages/index.js"
    },
    "./concerns": {
      "types": "./dist/recon/concerns/index.d.ts",
      "import": "./dist/recon/concerns/index.js"
    },
    "./behaviors": {
      "types": "./dist/recon/behaviors/index.d.ts",
      "import": "./dist/recon/behaviors/index.js"
    },
    "./managers": {
      "types": "./dist/recon/managers/index.d.ts",
      "import": "./dist/recon/managers/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "UNLICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "recker": "1.0.103"
  },
  "optionalDependencies": {
    "redblue-cli": "^0.1.0"
  },
  "peerDependencies": {
    "@baldin/core": "^0.2.0"
  },
  "devDependencies": {
    "@baldin/adapter-memory": "workspace:*",
    "@baldin/core": "workspace:*",
    "@types/node": "25.5.2",
    "typescript": "6.0.2"
  }
}
