{
  "name": "@baldim/plugin-identity",
  "version": "0.1.0",
  "type": "module",
  "description": "OAuth2 and OpenID Connect identity provider with sessions, MFA, onboarding, and administrative UI for Baldim.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldim.git",
    "directory": "plugins/identity"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "import": "./dist/drivers/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').mkdirSync('dist/ui/styles',{recursive:true});require('node:fs').copyFileSync('src/ui/styles/main.css','dist/ui/styles/main.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@baldim/plugin-audit": "workspace:*",
    "raffel": "1.0.26"
  },
  "optionalDependencies": {
    "@maxmind/geoip2-node": "^6.3.4",
    "argon2": "^0.44.0",
    "nodemailer": "^10.0.1",
    "otpauth": "^9.4.1",
    "qrcode": "^1.5.4",
    "tuiuiu.js": "1.0.63"
  },
  "peerDependencies": {
    "@baldim/core": "^0.2.0"
  },
  "devDependencies": {
    "@baldim/adapter-memory": "workspace:*",
    "@baldim/core": "workspace:*",
    "@types/node": "25.5.2",
    "typescript": "6.0.2"
  }
}
