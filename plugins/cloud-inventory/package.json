{
  "name": "@baldin/plugin-cloud-inventory",
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-cloud resource discovery, snapshots, diffs, schedules, and Terraform export for Baldin.",
  "license": "Unlicense",
  "engines": { "node": ">=24" },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldin.git",
    "directory": "plugins/cloud-inventory"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./drivers": { "types": "./dist/cloud-inventory/drivers/index.d.ts", "import": "./dist/cloud-inventory/drivers/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "UNLICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
