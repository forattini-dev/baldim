{
  "name": "@baldin/plugin-cache",
  "version": "0.1.1",
  "type": "module",
  "description": "Memory, filesystem, Redis, object-storage, partition-aware, and multi-tier caching for Baldin.",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldin.git",
    "directory": "plugins/cache"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drivers": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "UNLICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "json-stable-stringify": "^1.3.0"
  },
  "peerDependencies": {
    "@baldin/core": "^0.2.0",
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@baldin/adapter-memory": "workspace:*",
    "@baldin/core": "workspace:*",
    "@types/node": "25.5.2",
    "ioredis": "^5.10.1",
    "typescript": "6.0.2"
  }
}
