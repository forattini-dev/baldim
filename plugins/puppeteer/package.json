{
  "name": "@baldin/plugin-puppeteer",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser automation, proxy pools, cookies, monitoring, and anti-bot inspection for Baldin.",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldin.git",
    "directory": "plugins/puppeteer"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "UNLICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "ghost-cursor": "^1.0.0",
    "puppeteer-extra": "^3.0.0",
    "puppeteer-extra-plugin-stealth": "^2.0.0",
    "user-agents": "^1.0.0"
  },
  "optionalDependencies": {
    "puppeteer": "^24.29.1"
  },
  "peerDependencies": {
    "@baldin/core": "^0.2.0"
  },
  "devDependencies": {
    "@baldin/adapter-memory": "workspace:*",
    "@baldin/core": "workspace:*",
    "@types/node": "25.5.2",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  }
}
