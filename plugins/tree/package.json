{
  "name": "@baldim/plugin-tree",
  "version": "0.1.1",
  "type": "module",
  "description": "Adjacency-list and nested-set tree models for Baldim resources.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldim.git",
    "directory": "plugins/tree"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@baldim/core": "^0.2.0"
  },
  "devDependencies": {
    "@baldim/adapter-memory": "workspace:*",
    "@baldim/core": "workspace:*",
    "@types/node": "25.5.2",
    "typescript": "7.0.2"
  }
}
