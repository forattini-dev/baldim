{
  "name": "@baldin/plugin-state-machine",
  "version": "0.0.0",
  "type": "module",
  "description": "Persistent state machines with guards, hooks, triggers, TTL, and transition history for Baldin.",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldin.git",
    "directory": "plugins/state-machine"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "UNLICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@baldin/core": "^0.0.0",
    "@baldin/plugin-scheduler": "^0.0.0"
  },
  "peerDependenciesMeta": {
    "@baldin/plugin-scheduler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@baldin/adapter-memory": "workspace:*",
    "@baldin/core": "workspace:*",
    "@baldin/plugin-scheduler": "workspace:*",
    "@types/node": "25.5.2",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  }
}
