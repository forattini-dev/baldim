{
  "name": "baldin-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "check:deps": "node scripts/check-package-dependencies.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "6.0.2",
    "vitest": "4.1.11",
    "@changesets/cli": "3.0.2"
  }
}
