{
  "name": "@baldin/cli",
  "version": "0.0.0",
  "type": "module",
  "description": "Command-line interface for Baldin databases.",
  "license": "Unlicense",
  "engines": { "node": ">=24" },
  "bin": { "baldin": "./dist/index.js" },
  "files": ["dist", "README.md", "UNLICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@baldin/adapter-filesystem": "workspace:*",
    "@baldin/adapter-memory": "workspace:*",
    "@baldin/adapter-reddb": "workspace:*",
    "@baldin/adapter-s3": "workspace:*",
    "@baldin/adapter-sqlite": "workspace:*",
    "@baldin/core": "workspace:*",
    "@baldin/mcp": "workspace:*",
    "@baldin/testing": "workspace:*",
    "@baldin/typegen": "workspace:*",
    "cli-args-parser": "^1.0.6",
    "tuiuiu.js": "1.0.63"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  }
}
