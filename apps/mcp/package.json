{
  "name": "@baldim/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Model Context Protocol server for Baldim documentation and databases.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "baldim-mcp": "./dist/entrypoint.js"
  },
  "main": "./dist/entrypoint.js",
  "types": "./dist/entrypoint.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entrypoint.d.ts",
      "import": "./dist/entrypoint.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@baldim/adapter-filesystem": "workspace:*",
    "@baldim/adapter-memory": "workspace:*",
    "@baldim/adapter-reddb": "workspace:*",
    "@baldim/adapter-s3": "workspace:*",
    "@baldim/adapter-sqlite": "workspace:*",
    "@baldim/core": "workspace:*",
    "@baldim/plugin-cache": "workspace:*",
    "@baldim/plugin-costs": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.1",
    "fuse.js": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "6.0.2"
  }
}
