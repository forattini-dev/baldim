{
  "name": "@baldin/adapter-s3",
  "version": "0.1.0",
  "type": "module",
  "description": "S3-compatible storage adapter for Baldin, including AWS S3, Cloudflare R2, and MinIO.",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/baldin.git",
    "directory": "adapters/s3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "UNLICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@baldin/core": "workspace:*",
    "lodash-es": "^4.18.1",
    "recker": "1.0.103"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "25.5.2",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  }
}
